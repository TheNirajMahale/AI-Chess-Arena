# AI Chess Arena - Environment Configuration Template
# Copy this file to .env and insert your API keys (optional - keys can also be saved in UI)

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=

# DeepSeek Official API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=

# Anthropic Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Groq Cloud API (https://console.groq.com/)
GROQ_API_KEY=

# OpenRouter Unified API (https://openrouter.ai/)
OPENROUTER_API_KEY=
